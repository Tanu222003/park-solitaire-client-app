{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd park-solitaire-frontend && npm install",
  "buildCommand": "cd park-solitaire-frontend && npm run build",
  "outputDirectory": "park-solitaire-frontend/dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
