{
  "info": {
    "_postman_id": "park-solitaire-api-collection",
    "name": "Park Solitaire Production API (Railway)",
    "description": "Production API endpoints for Park Solitaire Lifespaces LLP hosted on Railway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://park-solitaire-backend-production.up.railway.app",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Server Status",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Quick check to verify that the Railway backend server is running."
          },
          "response": []
        },
        {
          "name": "API Info & Endpoints Directory",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api",
              "host": ["{{baseUrl}}"],
              "path": ["api"]
            },
            "description": "Returns a directory of all available endpoints and system version."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token automatically saved to collection variable: ' + jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@parksolitaire.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in as System Admin and automatically saves the JWT token for subsequent requests."
          },
          "response": []
        },
        {
          "name": "Channel Partner Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Partner token saved: ' + jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"partner@parksolitaire.com\",\n  \"password\": \"partner123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in as Channel Partner."
          },
          "response": []
        },
        {
          "name": "Get Current User Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Returns current logged in user details."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Clients & CRM",
      "item": [
        {
          "name": "Get All Clients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clients"]
            },
            "description": "Retrieves list of registered clients from Railway MySQL database."
          },
          "response": []
        },
        {
          "name": "Add New Client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohan Mehta\",\n  \"phone\": \"+91 98765 43210\",\n  \"email\": \"rohan.mehta@example.com\",\n  \"budget\": \"1.8 Cr\",\n  \"propertyType\": \"3 BHK Premium\",\n  \"leadStage\": \"Site Visit Scheduled\",\n  \"visitDate\": \"2026-09-25\",\n  \"visitTime\": \"11:30 AM\",\n  \"notes\": \"Interested in high floor Park facing tower\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/clients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clients"]
            },
            "description": "Registers a new client and schedules site visit."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Visits & Dashboard",
      "item": [
        {
          "name": "Get All Scheduled Visits",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/visits",
              "host": ["{{baseUrl}}"],
              "path": ["api", "visits"]
            },
            "description": "Lists all scheduled visits."
          },
          "response": []
        },
        {
          "name": "Admin Dashboard Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "dashboard"]
            },
            "description": "Returns counts, metrics, client pipeline stages, and total payment approval amounts."
          },
          "response": []
        }
      ]
    }
  ]
}
